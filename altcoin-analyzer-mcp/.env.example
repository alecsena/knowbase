# =============================================================
# LLM Configuration — Primary Provider
# =============================================================
# Supported providers: anthropic | openrouter | openai
LLM_PROVIDER=anthropic

# Anthropic (Claude)
ANTHROPIC_API_KEY=sk-ant-xxxxx
# Used when LLM_PROVIDER=anthropic
ANTHROPIC_MODEL=claude-sonnet-4-6

# OpenRouter  (https://openrouter.ai)
OPENROUTER_API_KEY=sk-or-xxxxx
# Example models: openai/gpt-4o, anthropic/claude-3.5-sonnet, meta-llama/llama-3.1-70b-instruct
OPENROUTER_MODEL=openai/gpt-4o
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# OpenAI
OPENAI_API_KEY=sk-xxxxx
OPENAI_MODEL=gpt-4o

# =============================================================
# LLM Fallback Provider (activated when primary fails)
# =============================================================
LLM_FALLBACK_PROVIDER=openrouter
LLM_FALLBACK_MODEL=meta-llama/llama-3.1-70b-instruct
# Leave blank to disable fallback
# LLM_FALLBACK_PROVIDER=

# =============================================================
# Data Providers
# =============================================================
COINGECKO_API_KEY=
COINGECKO_BASE_URL=https://api.coingecko.com/api/v3
GITHUB_TOKEN=ghp_xxxxx
DEFILLAMA_BASE_URL=https://api.llama.fi

# =============================================================
# Server
# =============================================================
LOG_LEVEL=INFO
CACHE_TTL_SECONDS=300

# =============================================================
# Scoring Defaults
# =============================================================
DEFAULT_RISK_PROFILE=moderate
